local function getMoney()
    local ok, result = pcall(function()
        local ls = LocalPlayer:FindFirstChild("leaderstats")
        if ls then
            for _, stat in pairs(ls:GetChildren()) do
                local name = string.lower(stat.Name)
                for _, m in ipairs(CONFIG.MONEY_STAT_NAMES) do
                    if name:find(m, 1, true) then
                        if stat:IsA("IntValue") or stat:IsA("NumberValue") then
                            return stat.Value
                        end
                    end
                end
            end
        end
        return 0
    end)
    if ok then return result end
    return 0
end

local function getChestPosition(prompt)
    local ok, result = pcall(function()
        local parent = prompt.Parent
        if not parent then return nil end
        if parent:IsA("Attachment") and parent.WorldPosition then return parent.WorldPosition end
        if parent:IsA("BasePart") then return parent.Position end
        if parent:IsA("Model") then
            if parent.PrimaryPart then return parent.PrimaryPart.Position end
            local part = parent:FindFirstChildWhichIsA("BasePart", true)
            if part then return part.Position end
        end
        local part = parent:FindFirstChildWhichIsA("BasePart", true)
        if part then return part.Position end
        if parent.Parent and parent.Parent:IsA("BasePart") then return parent.Parent.Position end
        return nil
    end)
    if ok then return result end
    return nil
end

local function isChestPrompt(prompt)
    if not prompt or not prompt.Parent then return false end
    local ok, result = pcall(function()
        local objText = string.lower(prompt.ObjectText or "")
        local actText = string.lower(prompt.ActionText or "")
        local parentName = string.lower(prompt.Parent.Name or "")
        local combined = objText .. " " .. parentName .. " " .. actText
        for _, bl in ipairs(CONFIG.CHEST_BLACKLIST) do
            if combined:find(bl, 1, true) then return false end
        end
        for _, kw in ipairs(CONFIG.CHEST_WHITELIST) do
            if combined:find(kw, 1, true) then return true end
        end
        return false
    end)
    return ok and result
end

local function randomFloat(min, max) return min + math.random() * (max - min) end

-- ============================================================
-- TP SUAVE
-- ============================================================
local function tpToPosition(targetPos)
    local char = LocalPlayer.Character
    if not char then return false end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return false end

    local startPos = root.Position
    local distance = (targetPos - startPos).Magnitude

    if distance < 5 then
        pcall(function()
            root.CFrame = CFrame.new(targetPos)
        end)
        return true
    end

    local duration = CONFIG.TP_DURATION
    local connection
    local elapsed = 0
    local finished = false

    connection = RunService.Heartbeat:Connect(function(dt)
        if finished then
            if connection then connection:Disconnect() end
            return
        end
        elapsed = elapsed + dt
        local alpha = math.min(elapsed / duration, 1)
        local smoothAlpha
        if alpha < 0.5 then
            smoothAlpha = 4 * alpha * alpha * alpha
        else
            smoothAlpha = 1 - math.pow(-2 * alpha + 2, 3) / 2
        end
        local currentPos = startPos:Lerp(targetPos, smoothAlpha)
        pcall(function()
            root.CFrame = CFrame.new(currentPos)
        end)
        if alpha >= 1 then
            finished = true
            if connection then connection:Disconnect() end
        end
    end)

    local waitStart = tick()
    while not finished and tick() - waitStart < duration + 0.1 do
        task.wait(0.01)
    end
    if connection then connection:Disconnect() end
    pcall(function()
        root.CFrame = CFrame.new(targetPos)
    end)
    task.wait(0.03)
    return true
end

-- ============================================================
-- ROBUST CLICK
-- ============================================================
local function robustClick(button)
    if not button then return false end
    if not getconnections then return false end
    local clicked = false
    local eventsToTry = {"MouseButton1Down", "Activated", "MouseButton1Click", "MouseButton1Up", "TouchTap", "InputBegan"}
    for _, eventName in ipairs(eventsToTry) do
        pcall(function()
            local event = button[eventName]
            if event then
                local conns = getconnections(event)
                if conns and #conns > 0 then
                    local conn = conns[1]
                    if conn and conn.Function then
                        task.spawn(conn.Function)
                        clicked = true
                    end
                end
            end
        end)
    end
    return clicked
end

