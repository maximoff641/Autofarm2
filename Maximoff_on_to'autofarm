-- ============================================================
local function getServerList()
    local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?limit=100&sortOrder=Asc"
    local success, response = pcall(function()
        return game:HttpGet(url)
    end)
    if not success or not response then return nil end
    local decodeSuccess, data = pcall(function()
        return HttpService:JSONDecode(response)
    end)
    if not decodeSuccess or not data or not data.data then return nil end
    return data.data
end

local function hopToPublicServer(reason)
    addLog("HOP", (reason or "Changing server..."))
    STATE.isRunning = false

    SAVE_DATA.autoFarmEnabled = true
    SAVE_DATA.serverHopEnabled = CONFIG.SERVER_HOP_ENABLED
    SAVE_DATA.chestsTotal = STATE.chestsTotal
    SAVE_DATA.hopCount = STATE.hopCount + 1
    SAVE_DATA.totalRuntime = STATE.totalRuntime
    SAVE_DATA.lastJobId = game.JobId
    saveConfig()

    if type(STATE.visitedJobIds) ~= "table" then
        STATE.visitedJobIds = {}
    end

    CURRENT_JOB_ID = game.JobId
    STATE.visitedJobIds[CURRENT_JOB_ID] = tick()

    local cleanupTime = tick()
    for jobId, timestamp in pairs(STATE.visitedJobIds) do
        if type(timestamp) == "number" and (cleanupTime - timestamp) > CONFIG.VISIT_EXPIRE then
            STATE.visitedJobIds[jobId] = nil
        end
    end

    local randomDelay = math.random(3, 6)
    addLog("HOP", "Esperando " .. randomDelay .. "s para evitar rate limit...")
    task.wait(randomDelay)
    addLog("HOP", "Buscando servidor nuevo...")

    local servers = getServerList()
    local chosenJobId = nil

    if servers and #servers > 0 then
        local now = tick()
        local validServers = {}
        local blockedCount = 0
        local unlockedCount = 0

        for _, server in ipairs(servers) do
            local isFull = server.playing >= server.maxPlayers
            local isCurrent = server.id == CURRENT_JOB_ID

            local visitTime = STATE.visitedJobIds[server.id]
            local recentlyVisited = false
            if visitTime and type(visitTime) == "number" then
                local timeSinceVisit = now - visitTime
                if timeSinceVisit < CONFIG.VISIT_EXPIRE then
                    recentlyVisited = true
                else
                    unlockedCount = unlockedCount + 1
                end
            end

            if recentlyVisited then
                blockedCount = blockedCount + 1
            end

            if not isFull and not isCurrent and not recentlyVisited then
                table.insert(validServers, server.id)
            end
        end

        addLog("HOP", "Servidores: " .. #servers .. " | Bloqueados: " .. blockedCount .. " | Disponibles: " .. #validServers)

        if #validServers > 0 then
            chosenJobId = validServers[math.random(1, #validServers)]
            addLog("HOP", "Servidor elegido: " .. string.sub(chosenJobId, 1, 8) .. "...")
        else
            addLog("HOP", "No hay servidores disponibles")
        end
    else
        addLog("HOP", "API no disponible")
    end

    if chosenJobId then
        STATE.visitedJobIds[chosenJobId] = tick()
        local success, err = pcall(function()
            TeleportService:TeleportToPlaceInstance(game.PlaceId, chosenJobId, LocalPlayer)
        end)
        if not success then
            addLog("HOP", "Error, usando Teleport normal")
            pcall(function()
                TeleportService:Teleport(game.PlaceId, LocalPlayer)
            end)
        end
    else
        pcall(function()
            TeleportService:Teleport(game.PlaceId, LocalPlayer)
        end)
    end

    return true
end

local function serverHop(reason) return hopToPublicServer(reason) end

local function checkNoChestsAndHop()
    if not CONFIG.HOP_ON_NO_CHESTS then return end
    if not STATE.isRunning then return end

    local pendingChests = 0
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") and not STATE.processedPrompts[obj] then
            if isChestPrompt(obj) then pendingChests = pendingChests + 1 end
        end
    end

    if pendingChests > 0 then
        STATE.lastChestTime = tick()
        return
    end

    local now = tick()
    local timeSinceLastChest = now - STATE.lastChestTime

    -- Hop casi inmediato: si no hay cofres en 2 segundos, hop
    if timeSinceLastChest >= 2 and STATE.lastScanCount == 0 then
        addLog("HOP", "No chests found after 2s - hopping immediately")
        STATE.hopCount = STATE.hopCount + 1
        STATE.lastChestTime = now
        serverHop("No chests found")
        return
    end

    if timeSinceLastChest >= CONFIG.RESET_CHESTS_AFTER and STATE.lastScanCount == 0 then
        addLog("HOP", "Reset de cofres procesados")
        STATE.processedPrompts = setmetatable({}, {__mode = "k"})
        STATE.lastChestTime = now
        return
    end

    if timeSinceLastChest >= CONFIG.NO_CHESTS_TIMEOUT then
        addLog("HOP", math.floor(timeSinceLastChest) .. "s no chests - hop")
        STATE.hopCount = STATE.hopCount + 1
        STATE.lastChestTime = now
        serverHop("No chests in map")
    end
end

-- ============================================================
-- LOOPS
-- ============================================================
local function findAndProcessAll()
    local chests = {}
    for _, obj in pairs(workspace:GetDescendants()) do
        if not STATE.isRunning then return end
        if obj:IsA("ProximityPrompt") and not STATE.processedPrompts[obj] then
            if isChestPrompt(obj) then table.insert(chests, obj) end
        end
    end
    if #chests > 0 then
        STATE.lastChestDetected = tick()
        if STATE.lastScanCount ~= #chests then
            STATE.lastScanCount = #chests
            addLog("SCAN", #chests .. " chests")
        end
    else
        STATE.lastScanCount = 0
    end
    for _, prompt in ipairs(chests) do
        if not STATE.isRunning then return end
        processChest(prompt)
    end
end

local function startFarming()
    if STATE.isRunning then return end
    STATE.isRunning = true
    STATE.sessionStartTime = tick()
    STATE.chestsThisSession = 0
    STATE.moneyStart = getMoney()
    STATE.moneyCurrent = STATE.moneyStart
    STATE.processedPrompts = setmetatable({}, {__mode = "k"})
    STATE.lastChestTime = tick()
    STATE.lastChestDetected = tick()
    STATE.lastScanCount = -1
    STATE.lastLoadedJobId = game.JobId
    addLog("START", "Auto Farm started")

    SAVE_DATA.autoFarmEnabled = true
    saveConfig()

    task.spawn(function()
        task.wait(0.5)
        selectCharacterAndPlay()
        for i = 1, 8 do
            task.wait(1.5)
            if LocalPlayer.Character then
                addLog("START", "In match")
                break
            end
        end
    end)

    task.spawn(function()
        task.wait(CONFIG.INITIAL_SCAN_DELAY)
        while STATE.isRunning do
            findAndProcessAll()
            if CONFIG.SERVER_HOP_ENABLED then
                if STATE.chestsThisSession >= CONFIG.CHESTS_BEFORE_HOP then
                    STATE.hopCount = STATE.hopCount + 1
                    addLog("HOP", "Hop #" .. STATE.hopCount)
                    serverHop("Chest collected")
                    task.wait(CONFIG.WAIT_AFTER_HOP)
                    STATE.chestsThisSession = 0
                end
            end
            task.wait(0.05)
        end
    end)

    task.spawn(function()
        task.wait(CONFIG.INITIAL_SCAN_DELAY + 3)
        while STATE.isRunning do
            task.wait(CONFIG.NO_CHESTS_CHECK_INTERVAL)
            if STATE.isRunning then pcall(checkNoChestsAndHop) end
        end
    end)
end

local function stopFarming()
    STATE.isRunning = false
    if STATE.sessionStartTime > 0 then
        STATE.totalRuntime = STATE.totalRuntime + (tick() - STATE.sessionStartTime)
        STATE.sessionStartTime = 0
        SAVE_DATA.totalRuntime = STATE.totalRuntime
    end
    SAVE_DATA.autoFarmEnabled = false
    saveConfig()
    addLog("STOP", "Auto Farm stopped")
end

