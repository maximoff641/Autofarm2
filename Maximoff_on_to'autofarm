-- ============================================================
-- SISTEMA DE ARRASTRAR EL BOTON (drag)
-- ============================================================
local dragging = false
local dragStart = nil
local startPos = nil
local wasDragged = false

toggleOpen.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        wasDragged = false
        dragStart = input.Position
        startPos = toggleOpen.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        if math.abs(delta.X) > 5 or math.abs(delta.Y) > 5 then
            wasDragged = true
        end
        if wasDragged then
            toggleOpen.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        if dragging and wasDragged then
            SAVE_DATA.buttonPosition = {
                xScale = toggleOpen.Position.X.Scale,
                xOffset = toggleOpen.Position.X.Offset,
                yScale = toggleOpen.Position.Y.Scale,
                yOffset = toggleOpen.Position.Y.Offset,
            }
            saveConfig()
            addLog("DRAG", "Boton movido y guardado")
        end
        dragging = false
    end
end)

