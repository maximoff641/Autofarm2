local isSelecting = false

local function selectCharacterAndPlay()
    if isSelecting then return false end
    isSelecting = true

    local t0 = tick()
    addLog("SELECT", "Looking for MenuGui...")

    local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if not pg then isSelecting = false; return false end

    local menuGui, mainFrame
    local waitStart = tick()
    while tick() - waitStart < 6 do
        if not menuGui then menuGui = pg:FindFirstChild("MenuGui") end
        if menuGui and not mainFrame then mainFrame = menuGui:FindFirstChild("MainFrame") end
        if mainFrame then break end
        task.wait(0.02)
    end
    if not mainFrame then
        addLog("SELECT", "MenuGui timeout")
        isSelecting = false
        return false
    end

    local btn
    local btnWaitStart = tick()
    while tick() - btnWaitStart < 4 do
        local charFrames = mainFrame:FindFirstChild("CharacterFrames")
        if charFrames then
            local charFrame = charFrames:FindFirstChild("InvisibleWoman")
            if charFrame then
                btn = charFrame:FindFirstChild("Button")
                if btn then break end
            end
        end
        task.wait(0.02)
    end

    if not btn then
        addLog("SELECT", "InvisibleWoman button not found")
        isSelecting = false
        return false
    end

    for attempt = 1, 6 do
        robustClick(btn)
        task.wait(0.05)
        local changed = false
        pcall(function()
            if btn.BackgroundColor3 ~= Color3.fromRGB(28, 28, 42) then
                changed = true
            end
        end)
        if changed then break end
    end

    task.wait(0.15)

    local playBtn
    local playWaitStart = tick()
    while tick() - playWaitStart < 2 do
        local buttons = mainFrame:FindFirstChild("Buttons")
        if buttons then
            playBtn = buttons:FindFirstChild("Play")
            if playBtn then break end
        end
        task.wait(0.02)
    end

    if playBtn then
        robustClick(playBtn)
        task.wait(0.15)
        robustClick(playBtn)
    end

    isSelecting = false
    return true
end

-- ============================================================
-- PROCESAR COFRE
-- ============================================================
local function processChest(prompt)
    if not prompt or not prompt.Parent then return false end
    if STATE.processedPrompts[prompt] then return false end
    if not isChestPrompt(prompt) then return false end

    local pos = getChestPosition(prompt)
    if not pos then return false end

    if not tpToPosition(pos + Vector3.new(0, CONFIG.TP_OFFSET, 0)) then return false end

    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if root then
        local targetPos = pos + Vector3.new(0, CONFIG.TP_OFFSET, 0)
        local dist = (root.Position - targetPos).Magnitude
        if dist > 15 then
            tpToPosition(targetPos)
        end
    end

    local chestRef = prompt.Parent
    local collected = false

    for attempt = 1, CONFIG.ACTIVATE_RETRIES do
        if not prompt.Parent then collected = true; break end

        pcall(function() fireproximityprompt(prompt) end)

        pcall(function()
            prompt:InputHoldBegin()
            task.wait(0.05)
            prompt:InputHoldEnd()
        end)

        pcall(function()
            if prompt.HoldDuration and prompt.HoldDuration > 0 then
                prompt.HoldDuration = 0
            end
        end)

        task.wait(CONFIG.ACTIVATE_DELAY)

        if not chestRef or not chestRef.Parent then collected = true; break end
        if not prompt.Parent then collected = true; break end
    end

    local waitStart = tick()
    while tick() - waitStart < 1.0 do
        if not chestRef or not chestRef.Parent then collected = true; break end
        if not prompt.Parent then collected = true; break end
        task.wait(0.05)
    end

    if collected then
        STATE.chestsThisSession = STATE.chestsThisSession + 1
        STATE.chestsTotal = STATE.chestsTotal + 1
        STATE.processedPrompts[prompt] = true
        STATE.lastChestTime = tick()
        local newMoney = getMoney()
        if newMoney > STATE.moneyCurrent then
            STATE.moneyTotal = STATE.moneyTotal + (newMoney - STATE.moneyCurrent)
            STATE.moneyCurrent = newMoney
        end

        SAVE_DATA.chestsTotal = STATE.chestsTotal
        SAVE_DATA.moneyTotal = STATE.moneyTotal
        saveConfig()

        addLog("CHEST", "#" .. STATE.chestsThisSession)
        task.wait(randomFloat(CONFIG.PAUSE_MIN, CONFIG.PAUSE_MAX))
        return true
    end
    return false
end

